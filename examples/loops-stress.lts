var s = "lol";

for(var k = 0; k < 10000; k += 1) {
    s += "hi";
}

print_line("Testing break and continue");

for (var i = 0; i < 10; i += 1) {
    if i == 3 {
        continue;
    }
    if i == 7 {
        break;
    }
    print_line(i);
}

var i = 0;
while true {
    if i == 3 {
        i += 1;
        continue;
    }
    if i == 7 {
        break;
    }
    print_line(i);
    i += 1;
}

i = 0;
do {
    if i == 3 {
        i += 1;
        continue;
    }
    if i == 7 {
        break;
    }
    print_line(i);
    i += 1;
} while true;