func perform_guess(var guess_number) {
    print("Guess ", guess_number, "/10 : ");
    var guess_str = input();

    if not is_integer(guess_str) {
        print_line("Please enter an integer between 1-100");
        return none;
    }

    var guess = to_number(guess_str);

    if guess < 0 or guess > 100 {
        print_line("Please enter an integer between 1-100");
        return none;
    }

    return guess;
}

var number = rand_int(1, 100);
print_line("I'm thinking of a number from 0-100");
var guess_number = 1;

while true {
    var guess = perform_guess(guess_number); 
    if guess == none continue;   

    if(guess > number) {
        print_line("Number is lower");
    } else if(guess < number) {
        print_line("Number is higher");
    } else {
        print_line("You guessed it!");
        break;
    }
    if(guess_number == 10) {
        print_line("You ran out of guesses");
        print_line("The number was: ", number);
        break;
    }
}

