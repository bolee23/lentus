// Declaring a function with the "func" keyword
func double(x) {
    return x + x;
}

var x = 3;

print_line(double(x));

// Closures
// This function returns another function which always returns 5.
func create_function_returning_five() {

    var five = 5;

    func function_returning_five() {
        return five;
    }

    // Return the function that returns 5 as a value.
    return function_returning_five;
}

// five_function contains a function returns 5 when called
var five_function = create_function_returning_five();

print_line(five_function()); // 5

// SOME_CONSTANT is declared later.
func print_some_constant() {
    print_line(SOME_CONSTANT);
}

// print_some_constant(); If called here, would cause an error
var SOME_CONSTANT = "Hello World!";
print_some_constant(); // Would be completely fine if called here.