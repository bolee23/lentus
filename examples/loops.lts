print("Counting to five!");
for(var i = 1; i <= 5; i += 1) {
    print(i);
}

print("Counting to five without braces!");

for(var i = 1; i <= 5; i += 1) print(i);


print("Counting to five without initializer!");
var i = 1;
for(; i <= 5; i += 1) print(i);

print("Counting to five without post increment!");
for(var i = 1; i <= 5;) {
    print(i);
    i += 1;
}

print("Counting to five using while loop!");
var j = 1;
while j <= 5 {
    print(j);
    j += 1;
}

print("Counting to five using do loop!");
j = 1;
do {
    print(j);
    j += 1;
} while j <= 5;

for(var k = 0; k < 5000000; k += 1) {
}