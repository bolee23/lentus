var hi = true;

// Conditions do not require () around them
if hi {
    print_line("1. hi is true");
} else {
    print_line("1. hi is false");
}

// For one statement is used the {} aren't required either.
if hi print_line("2. hi is true");
if not hi print_line("2. hi is false");

if hi print_line("3. hi is true"); else print_line("3. hi is false");
